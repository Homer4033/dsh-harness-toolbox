{
  "name": "dsh-harness-toolbox",
  "version": "1.8.9",
  "private": false,
  "type": "module",
  "description": "Five-tier context compaction for DeepSeek Harness plus global rules editing, a managed component installer (gh, git, ffmpeg/ffprobe, Python) below one migratable download root, GitHub device login and per-session repository publishing.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Homer",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context",
    "compaction",
    "rules",
    "toolbox",
    "ffmpeg",
    "github"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Homer4033/dsh-harness-toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/Homer4033/dsh-harness-toolbox/issues"
  },
  "homepage": "https://github.com/Homer4033/dsh-harness-toolbox#readme",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
