{
  "name": "dsh-harness-toolbox",
  "version": "2.7.1",
  "private": false,
  "type": "module",
  "description": "A DeepSeek Harness workbench built around five-tier context compaction: the optical context vial above the composer, two appearance palettes that follow the host light/dark theme, global and workspace rules editing, managed installs for gh / git / ffmpeg / Python below one migratable root, a local FLUX.2 [klein] 4B download kept in its own models folder, and per-session repository publishing.",
  "license": "GPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "author": "Homer",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context",
    "compaction",
    "rules",
    "toolbox",
    "workbench",
    "ffmpeg",
    "github",
    "optical-ui",
    "context-vial",
    "local-models",
    "flux",
    "glassmorphism"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Homer4033/dsh-harness-toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/Homer4033/dsh-harness-toolbox/issues"
  },
  "homepage": "https://github.com/Homer4033/dsh-harness-toolbox#readme",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./vendor/*": "./vendor/*",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "vendor",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "scripts"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
